# 2. 리스크 및 자금 관리 (Risk Management)
# -----------------------------------------------------------------
# [전체 리스크] 당일 누적 손실 차단 기준 (예: 0.20 = 총 평가액의 20% 손실 시 중단)
RISK_LOSS_LIMIT_RATE=0.20

# [전체 리스크] 당일 누적 손실 절대 금액 (단위: 원)
RISK_FIXED_LOSS_LIMIT=1000000

# [종목별 비중] 1개 종목 진입 시 자산 비중 (예: 0.05 = 총 자산의 5% 투입)
TRADE_MAX_STOCKS=10
TRADE_INVEST_PER_STOCK=5000000
TRADE_INVEST_RATE=0.10


# 3. 매매 전략 파라미터 (v2.6 수익성 최우선 튜닝)
# -----------------------------------------------------------------
# [익절] 목표 수익률 (0.9% 수수료 벽 돌파를 위한 6% 상향 타겟)
TRADE_TARGET_PROFIT=0.06

# [손절] 최대 허용 손실률
TRADE_STOP_LOSS=-0.015

# [본절 보호] ROI +1.0% 도달 시 손절가를 본절가(+0.3%)로 즉시 상향 [v3.6]
TRADE_BREAKEVEN_TRIGGER=0.01
TRADE_BREAKEVEN_PROTECT=0.003

# [트레일링 스톱] 활성화 기준 (수익권 안착 시점인 2.0%에서 시작)
TRAILING_STOP_ACTIVATION=0.02

# [트레일링 스톱] 하락 시 매도 기준 (고점 대비 0.5% 하락 시 조기 익절)
TRAILING_STOP_CALLBACK=0.005

# [거래 비용] 실제 거래 마찰 비용 (수수료+세금+슬리피지 합산) [v4.5]
TRADING_FRICTION=0.009


# [전략 세부 튜닝] 매수 타점 및 필터 설정 [v4.7 Update]
# -----------------------------------------------------------------
# 하강 다이버전스 인정 RSI 한도 (높을수록 더 자주 매수 / 추천: 60~80)
STRATEGY_RSI_LIMIT=75

# 볼린저 밴드 하단 대비 진입 허용폭 (1.05 = 하단선 위 5%까지 허용)
STRATEGY_BB_GAP=1.05

# [v4.5] V자 급반등(Nitro Reversion) 모드 설정 (RSI 22 이하 울트라 과매도 타겟)
STRATEGY_NITRO_RSI=22.0
STRATEGY_NITRO_BB_GAP=1.002
STRATEGY_MIN_RECOVERY=0.008

# [v4.7] 스캘핑 전용 타임컷 (매수 후 N분 내 결과 안나오면 강제 청산)
STRATEGY_EXIT_MINUTES=15

# 변동성 과폭 필터 (밴드 너비가 이 수치를 넘으면 이미 폭주로 간주하여 진입 금지)
STRATEGY_BB_WIDTH_LIMIT=0.03

# 신규 진입 마감 시간 (오후장 변동성 실종 대응)
STRATEGY_BUY_END_TIME=14:30

# 거시 신호(5분봉) 무시 여부 (필승법을 위해 거시 컨펌 필수 활성화)
STRATEGY_BYPASS_MACRO=False

# 매수 대기 상태 자동 해제 RSI 기준 (5분봉 RSI가 이 값을 넘으면 매수 포기)
STRATEGY_MACRO_RSI_EXIT=50

# 동일 종목 재진입 제한 시간 (초 / 1800 = 30분 동안 재진입 금지)
STRATEGY_SIGNAL_COOLDOWN=1800


# 4. 운영 및 기술 설정 (Operation Settings)
# -----------------------------------------------------------------
# [미체결 관리] 주문 후 체결 대기 시간 (초 / 예: 60 = 1분간 미체결 시 취소)
ORDER_PENDING_TIMEOUT=60

# [접속 복구] API 연결 실패 시 자동 재시도 횟수
RECONNECT_LIMIT=5

# [성능 최적화] 최대 실시간 감시 종목 수 (권장: 20~30)
MAX_MONITORED_STOCKS=50

# [데이터 보존] 조건 이탈 시 감시 데이터 유지 시간 (초 / 기본 600 = 10분)
MONITORING_GRACE_PERIOD=600


# 5. 전략 지표 설정 (Indicator Settings)
# -----------------------------------------------------------------
# [RSI] 상대강도지수 계산 기간 (기본: 14)
INDICATOR_RSI_PERIOD=14

# [볼린저밴드] 이동평균 기간 (기본: 20)
INDICATOR_BB_PERIOD=20

# [볼린저밴드] 표준편차 배수 (기본: 2.0)
INDICATOR_BB_STD=2.0

# [거래량] 수급 폭증 판별 기준 (하락장 항복 거래량 포착을 위해 4.0배 상향)
STRATEGY_VOL_RATIO=4.0

# [자동 매매 모드] 타점 확장 및 스캘핑 활성화
AGGRESSIVE_MODE=True

# [거래 시스템 점검용] 체결 테스트 모드 (거시/미시/BB 조건 중 1개만 발동해도 즉각 매수)
EXTREME_TEST_MODE=False


# 6. AI 신호 검증 모듈 (Machine Learning Signal Validator)
# -----------------------------------------------------------------
# [AI 학습 DB] 신호 스냅샷 저장 경로
AI_FEATURES_DB=ai_features.db

# [AI 모델] 학습된 모델 저장 경로
AI_MODEL_PATH=ai_model.pkl

# [Shadow Mode] 지금은 데이터 수집 기간 → True 유지 (200건 쌓이면 False로 전환)
AI_SHADOW_MODE=True

# [AI 승인 임계값] AI가 50% 이상 성공 확신 시에만 매수 (공격적 전환)
AI_THRESHOLD=0.50

# -----------------------------------------------------------------
# 6. 하이퍼 공격형 필터 제어 (Hyper-Aggressive Toggles) [v4.8]
# -----------------------------------------------------------------
# [추세 필터] 하강장 진입 허용 (역추세 매매 활성화)
