# ─────────────────────────────────────────────────────────────────
# 2. 리스크 및 자금 관리 (Risk Management)
# ─────────────────────────────────────────────────────────────────

# [전체 리스크 가드] 당일 누적 실현 손익 차단 기준 (예: 1000000 = 당일 100만원 손실 시 중단)
RISK_FIXED_LOSS_LIMIT=1000000
RISK_LOSS_LIMIT_RATE=0.20

# [종목당 비중] 한 종목당 투입할 자산 비중 (예: 0.05 = 전체 자산의 5%씩 분산 투자)
TRADE_INVEST_RATE=0.05


# ─────────────────────────────────────────────────────────────────
# 3. 매매 전략 파라미터 (Trading Targets)
# ─────────────────────────────────────────────────────────────────

# [익절] 목표 수익률 (예: 0.04 = 4% 도달 시 전량 수익 실현)
TRADE_TARGET_PROFIT=0.04

# [손절] 최대 허용 손실률 (예: -0.02 = 2% 하락 시 전량 손절)
TRADE_STOP_LOSS=-0.02

# [트레일링 스톱] 활성화 기준 (예: 0.02 = 2% 수익 도달 시부터 고점 추적 시작)
TRAILING_STOP_ACTIVATION=0.02

# [트레일링 스톱] 하락 폭 기준 (예: 0.01 = 최고점 대비 1% 하락 시 즉시 매도)
TRAILING_STOP_CALLBACK=0.01


# ─────────────────────────────────────────────────────────────────
# 4. 운영 및 기술 설정 (Operation settings)
# ─────────────────────────────────────────────────────────────────

# [미체결 관리] 주문 후 체결 대기 타임아웃 (단위: 초 / 예: 60 = 1분간 미체결 시 취소)
ORDER_PENDING_TIMEOUT=60

# [네트워크 복구] API 연결 실패 시 자동 재시도 횟수 (예: 5 = 5회 시도 후 종료)
RECONNECT_LIMIT=5

# [보조지표] RSI 지표 계산 기간 (단위: 캔들 개수 / 예: 14)
INDICATOR_RSI_PERIOD=14

# [보조지표] 볼린저 밴드 이동평균 기간 (예: 20)
INDICATOR_BB_PERIOD=20

# [보조지표] 볼린저 밴드 표준편차 배수 (예: 2.0)
INDICATOR_BB_STD=2.0


# ─────────────────────────────────────────────────────────────────
# 5. AI 신호 검증 모듈 (Machine Learning Signal Validator)
# ─────────────────────────────────────────────────────────────────

# [AI 학습 DB] 신호 스냅샷과 라벨이 저장되는 SQLite 파일 경로
AI_FEATURES_DB=ai_features.db

# [AI 모델] 학습된 LightGBM 모델이 저장되는 .pkl 파일 경로
AI_MODEL_PATH=ai_model.pkl

# [Shadow Mode] True: AI가 예측만 하고 매수 결정에 간섭하지 않음 (데이터 수집 기간)
#               False: AI가 승인한 신호만 실제 매수 집행 (Active 제어 모드)
AI_SHADOW_MODE=True

# [AI 승인 임계값] 이 확률 이상일 때 AI가 매수를 승인 (Active 모드에서만 적용)
# (예: 0.72 = AI가 72% 이상 성공한다고 예측할 때만 매수 허용)
AI_THRESHOLD=0.72

# [최소 학습 샘플] Shadow → Active 전환에 필요한 최소 라벨 확정 데이터 수
# (예: 200 = 200건의 결과가 쌓이면 자동으로 Active 모드로 전환 가능)
AI_MIN_SAMPLES=200

# [라벨링 지연] 신호 발생 후 몇 분 뒤에 결과(성공/실패)를 판정할지 (단위: 분)
AI_LABEL_DELAY_MIN=30
