# =================================================================
# Dopaming-Stock-Bot 환경 변수 및 운영 설정
# =================================================================

# 1. 기본 시스템 설정
# -----------------------------------------------------------------
# 실전 매매 여부 (True: 가상 매매 / False: 실전 매매)
DRY_RUN_MODE=False

# 키움증권 계좌 비밀번호 (4자리)
# ※ 모의투자 시 '0000' 고정
ACCOUNT_PASSWORD=0000

# Slack Webhook URL (알림/리포트 수신용)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/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


# 2. 리스크 및 자금 관리 (Risk Management)
# -----------------------------------------------------------------
# [전체 리스크] 당일 누적 손실 차단 기준 (예: 0.50 = 총 평가액의 50% 손실 시 중단)
RISK_LOSS_LIMIT_RATE=0.50

# [종목별 비중] 1개 종목 진입 시 자산 비중 (예: 0.05 = 총 자산의 5% 투입)
TRADE_INVEST_RATE=0.05


# 3. 매매 전략 파라미터 (Trading Targets)
# -----------------------------------------------------------------
# [익절] 목표 수익률 (예: 0.04 = 4.0% 수익 시 청산)
TRADE_TARGET_PROFIT=0.04

# [손절] 최대 허용 손실률 (예: -0.02 = 2.0% 하락 시 청산)
TRADE_STOP_LOSS=-0.02

# [트레일링 스톱] 활성화 기준 (예: 0.02 = 2% 수익 도달 후부터 고점 추적)
TRAILING_STOP_ACTIVATION=0.02

# [트레일링 스톱] 하락 시 매도 기준 (예: 0.01 = 고점 대비 1.0% 하락 시 즉시 매도)
TRAILING_STOP_CALLBACK=0.01


# 4. 운영 및 기술 설정 (Operation Settings)
# -----------------------------------------------------------------
# [미체결 관리] 주문 후 체결 대기 시간 (초 / 예: 60 = 1분간 미체결 시 취소)
ORDER_PENDING_TIMEOUT=60

# [접속 복구] API 연결 실패 시 자동 재시도 횟수
RECONNECT_LIMIT=5

# [성능 최적화] 최대 실시간 감시 종목 수 (권장: 20~30)
MAX_MONITORED_STOCKS=20


# 5. 전략 지표 설정 (Indicator Settings)
# -----------------------------------------------------------------
# [RSI] 상대강도지수 계산 기간 (기본: 14)
INDICATOR_RSI_PERIOD=14

# [볼린저밴드] 이동평균 기간 (기본: 20)
INDICATOR_BB_PERIOD=20

# [볼린저밴드] 표준편차 배수 (기본: 2.0)
INDICATOR_BB_STD=2.0

# [자동 매매 모드] 타점 확장 및 스캘핑 활성화
AGGRESSIVE_MODE=True

# [거래 시스템 점검용] 체결 테스트 모드 (거시/미시/BB 조건 중 1개만 발동해도 즉각 매수)
EXTREME_TEST_MODE=False


# 6. AI 신호 검증 모듈 (Machine Learning Signal Validator)
# -----------------------------------------------------------------
# [AI 학습 DB] 신호 스냅샷 저장 경로
AI_FEATURES_DB=ai_features.db

# [AI 모델] 학습된 모델 저장 경로
AI_MODEL_PATH=ai_model.pkl

# [Shadow Mode] 지금은 데이터 수집 기간 → True 유지 (200건 쌓이면 False로 전환)
AI_SHADOW_MODE=True

# [AI 승인 임계값] AI가 72% 이상 성공 확신 시에만 매수 (Active 모드에서만 적용)
AI_THRESHOLD=0.72

# [최소 학습 샘플] 이 수치 이상 쌓여야 AI가 Active 모드로 자동 전환 가능
AI_MIN_SAMPLES=200

# [라벨링 지연] 신호 발생 후 결과 판정 시간 (분)
AI_LABEL_DELAY_MIN=30
