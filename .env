# 4. 운영 및 기술 설정
# [최적 모니터링 종목 수 가이드]
# 키움증권 OpenAPI 실시간 TR/Real 한도는 보통 스크린당 100개입니다.
# 하지만 100개를 꽉 채울 경우 잔고조회 등 기타 필수 TR 전송 시 한도 초과 오류(Rate Limit)가 
# 발생하거나 파이썬(스레드) 환경에서 과부하(CPU Lag)가 올 수 있습니다.
# 따라서 안정성과 기회 창출을 동시에 잡을 수 있는 '황금 밸런스'인 70~80개가 가장 이상적입니다.
MAX_MONITORED_STOCKS=80
TARGET_CONDITION_NAME=v11조건식
INDICATOR_RSI_PERIOD=14
INDICATOR_BB_PERIOD=20
INDICATOR_BB_STD=2.0
STRATEGY_VOL_RATIO=3.5
AGGRESSIVE_MODE=True
EXTREME_TEST_MODE=False

# 5. AI 신호 검증 모듈 (v10.0 Resurrection - Active)
AI_FEATURES_DB=ai_features.db
AI_MODEL_PATH=ai_model.pkl
AI_SHADOW_MODE=True
AI_THRESHOLD=0.38
AI_MIN_SAMPLES=200

# 키움 API 뻗음 방지용 최대 감시종목 수
MAX_MONITORED_STOCKS=80
