# [거래량 필터] 거래량 폭증 필수
STRATEGY_REQUIRE_VOL_SPIKE=True

# [스캐너 완화] 엄격한 스캐너 유지
STRATEGY_SCANNER_SOFT_MODE=False

# [최소 학습 샘플] 이 수치 이상 쌓여야 AI가 Active 모드로 자동 전환 가능
AI_MIN_SAMPLES=200

# [라벨링 지연] 신호 발생 후 결과 판정 시간 (분)
AI_LABEL_DELAY_MIN=30

# [시스템 로그 설정]
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/system.log

